---
import { ArrowRight } from '@lucide/astro'
import Layout from '../layouts/Layout.astro'
import { courses } from '../data/courses'
---

<Layout title="Stránka nenalezena | Autoškola KETTY" description="Tahle stránka neexistuje. Pokračuj na úvod nebo do přehledu kurzů Autoškoly KETTY.">
  <section class="pt-[140px] pb-24 lg:pt-[180px] lg:pb-32">
    <div class="max-w-7xl mx-auto px-5 lg:px-10">
      <div class="enter text-[14px] font-medium text-black/55" style="--i:0">Chyba 404</div>
      <h1 class="enter mt-4 font-display font-bold leading-[0.95] tracking-tight text-[clamp(44px,6.4vw,92px)] max-w-4xl" style="--i:1">
        Tady jsi asi špatně odbočil.
      </h1>
      <p class="enter mt-6 text-[17px] text-black/70 max-w-[50ch]" style="--i:2">Stránka, kterou hledáš, neexistuje nebo se přesunula. Zkus některý z kurzů.</p>
      <div class="enter mt-9 flex flex-wrap gap-3" style="--i:3">
        <a href="/" class="btn-primary inline-flex items-center gap-2 bg-[var(--ink)] text-[var(--lime)] font-semibold text-[15px] px-7 py-4 rounded-full">
          Na úvod <ArrowRight size={17} />
        </a>
        {courses.map((c) => (
          <a href={c.href} class="btn-secondary inline-flex items-center gap-2 text-[15px] font-semibold px-6 py-4 rounded-full border-2 border-[var(--ink)]/15 hover:border-[var(--ink)] hover:bg-white">{c.title}</a>
        ))}
      </div>
    </div>
  </section>
</Layout>
