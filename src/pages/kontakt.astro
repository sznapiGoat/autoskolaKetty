---
import Layout from '../layouts/Layout.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import Contact from '../components/Contact.astro'
---

<Layout
  title="Kontakt a přihláška | Autoškola KETTY"
  description="Kontakt na Autoškolu KETTY: Dopraváků 723, Praha 8 a Chotusice 136. Telefon 775 298 021, e-mail kettnerova@autoskolaketty.cz. Nezávazná přihláška online."
>
  <div class="[&>section]:pt-12 lg:[&>section]:pt-16 pt-[104px] lg:pt-[120px] bg-[var(--paper-2)] grain">
    <div class="max-w-7xl mx-auto px-5 lg:px-10">
      <div class="enter"><Breadcrumbs items={[{ label: 'Kontakt' }]} /></div>
    </div>
    <Contact as="h1" />
  </div>
</Layout>
