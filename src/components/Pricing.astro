---
import { ArrowRight } from '@lucide/astro'
import PriceRow from './PriceRow.astro'
import { pricingRegions, pricingExtras, pricingNote } from '../data/pricing'

interface Props {
  as?: 'h1' | 'h2'
}

const { as: Heading = 'h2' } = Astro.props
const contactHref = Astro.url.pathname === '/' ? '#kontakt' : '/kontakt#prihlaska'

const regions = [
  { ...pricingRegions.praha, accent: false, href: '/praha-8' },
  { ...pricingRegions.region, accent: true, href: '/caslav-kutna-hora' },
]
---

<section id="cenik" class="relative py-24 lg:py-32 bg-[var(--paper)]">
  <div class="max-w-7xl mx-auto px-5 lg:px-10">
    <div class="reveal max-w-3xl mb-16">
      <div class="text-[14px] font-medium text-black/55 mb-4">Ceník skupiny B</div>
      <Heading class="font-display font-bold text-[clamp(40px,5.5vw,76px)] leading-[0.95] tracking-tight">
        Přesný ceník.<br /><span class="text-black/50">Žádné překvapení.</span>
      </Heading>
      <p class="mt-6 max-w-[60ch] text-[16px] text-black/65 leading-relaxed">{pricingNote}</p>
    </div>

    <div class="grid md:grid-cols-2 gap-5 mb-5">
      {regions.map((r, i) => (
        <div class:list={[`reveal delay-${i + 1} rounded-3xl p-8 flex flex-col`, r.accent ? 'bg-[var(--lime)]' : 'bg-white border border-black/10']}>
          <h3 class="font-display text-[28px] font-bold leading-none mb-6">
            <a href={r.href} class="hover:underline underline-offset-4 decoration-2">{r.name}</a>
          </h3>
          {r.rows.map((row) => <PriceRow {...row} accent={r.accent} />)}
          <div aria-hidden="true" class="flex-1 min-h-8"></div>
          <a href={contactHref} class="btn-primary inline-flex items-center justify-center gap-2 font-semibold py-3.5 rounded-full bg-[var(--ink)] text-[var(--lime)]">
            Zapsat se <ArrowRight size={15} />
          </a>
        </div>
      ))}
    </div>

    <div class="grid md:grid-cols-3 gap-5">
      {pricingExtras.map((g, i) => (
        <div class={`reveal delay-${i + 1} rounded-3xl p-7 bg-[var(--paper-2)]`}>
          <h3 class="font-display text-[20px] font-bold mb-5">{g.title}</h3>
          {g.rows.map((row) => <PriceRow {...row} />)}
          {g.note && <p class="mt-5 text-[13px] text-black/60 leading-relaxed">{g.note}</p>}
        </div>
      ))}
    </div>
  </div>
</section>
