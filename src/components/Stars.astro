---
import { Star } from '@lucide/astro'

interface Props {
  size?: number
  class?: string
  fill?: string
  label?: string
}

const { size = 16, class: className = '', fill = 'fill-current', label = 'Hodnocení 5 z 5' } = Astro.props
---

<div class:list={['flex items-center gap-1', className]} role="img" aria-label={label}>
  {Array.from({ length: 5 }).map(() => <Star size={size} class={fill} aria-hidden="true" />)}
</div>
