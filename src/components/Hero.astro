---
import { Image } from 'astro:assets'
import { ArrowRight, Star } from '@lucide/astro'
import Stat from './Stat.astro'
import { site } from '../data/site'
import heroCar from '../assets/images/ketty1.jpg'
---

<section id="top" class="relative pt-[112px] lg:pt-[128px] overflow-hidden">
  <div aria-hidden="true" class="hero-blob absolute -top-24 -right-44 w-[340px] h-[340px] sm:-top-20 sm:-right-32 sm:w-[520px] sm:h-[520px] rounded-full bg-[var(--lime)] opacity-90"></div>

  <div class="relative max-w-7xl mx-auto px-5 lg:px-10 grid lg:grid-cols-12 gap-12 lg:gap-10 items-center">
    <div class="lg:col-span-7">
      <div class="enter inline-flex items-center bg-white border border-black/10 rounded-full px-3.5 py-1.5 mb-7 text-[13px] font-medium" style="--i:0">
        Zápis do kurzů je otevřený
      </div>

      <h1 class="enter font-display font-bold leading-[0.95] tracking-tight text-[clamp(44px,6.6vw,96px)]" style="--i:1">
        Řidičák, který<br />
        <span class="relative inline-block">
          <span class="relative z-10">opravdu</span>
          <span aria-hidden="true" class="highlight-bar absolute inset-x-0 bottom-1.5 h-[14px] lg:h-[22px] bg-[var(--lime)]"></span>
        </span>{' '}
        <span class="text-black/50">uděláš.</span>
      </h1>

      <p class="enter mt-7 max-w-[34rem] text-[17px] lg:text-[19px] text-black/70 leading-relaxed" style="--i:2">
        Instruktoři, kteří tě naučí jezdit, ne jen projít zkoušku. Praha&nbsp;8 a&nbsp;Chotusice, od&nbsp;17&nbsp;let.
      </p>

      <div class="enter mt-9 flex flex-wrap items-center gap-3" style="--i:3">
        <a href="#kontakt" class="btn-primary inline-flex items-center gap-2 bg-[var(--ink)] text-[var(--lime)] font-semibold text-[15px] px-7 py-4 rounded-full">
          Zapsat se <ArrowRight size={17} />
        </a>
        <a href="#kurzy" class="btn-secondary inline-flex items-center gap-2 text-[15px] font-semibold px-6 py-4 rounded-full border-2 border-[var(--ink)]/15 hover:border-[var(--ink)] hover:bg-white">
          Kurzy a ceny
        </a>
      </div>
    </div>

    <div class="lg:col-span-5 enter" style="--i:3">
      <div class="bg-[var(--ink)] rounded-[28px] p-7 text-white">
        <div class="flex items-start justify-between mb-6">
          <div>
            <div class="text-[13px] text-white/50">Nejčastější volba</div>
            <div class="font-display font-bold text-[32px] leading-[1.05] mt-1">Skupina B,<br />osobní auto</div>
          </div>
          <div class="bg-[var(--lime)] text-[var(--ink)] font-display font-bold text-[20px] w-11 h-11 flex items-center justify-center rounded-xl">B</div>
        </div>

        <div class="rounded-2xl overflow-hidden aspect-[4/3] ring-1 ring-white/10">
          <Image
            src={heroCar}
            alt="Červený Ford Focus Autoškoly KETTY s polepem a telefonním číslem"
            widths={[400, 600, 800, 960, 1280]}
            sizes="(min-width: 1024px) 460px, calc(100vw - 96px)"
            loading="eager"
            fetchpriority="high"
            class="w-full h-full object-cover"
          />
        </div>

        <div aria-hidden="true" class="mt-6 road-stripe-light"></div>

        <div class="mt-6 flex items-end justify-between gap-4">
          <div>
            <div class="text-[13px] text-white/50">Praha, od</div>
            <div class="font-display font-bold text-[40px] leading-none mt-1">22 900 <span class="text-[18px] font-medium text-white/60">Kč</span></div>
          </div>
          <a href="/cenik" class="ulink inline-flex items-center gap-1.5 text-[var(--lime)] font-semibold text-[14px] pb-1">
            Celý ceník <ArrowRight size={15} />
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="relative mt-20 lg:mt-24 border-y-2 border-[var(--ink)] bg-[var(--paper-2)]">
    <div class="max-w-7xl mx-auto px-5 lg:px-10 grid grid-cols-1 sm:grid-cols-3 divide-y-2 sm:divide-y-0 sm:divide-x-2 divide-[var(--ink)]">
      <Stat n={site.rating.value} sub={`hodnocení z ${site.rating.count} recenzí na Google`} href={site.googleReviewsUrl}>
        <Star slot="icon" size={14} class="inline -mt-0.5 mr-1 text-[var(--ink)] fill-[var(--lime)]" />
      </Stat>
      <Stat n="94 %" sub="studentů projde zkouškou napoprvé" />
      <Stat n="2 200+" sub="absolventů od roku 1998" />
    </div>
  </div>
</section>
