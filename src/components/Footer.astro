---
import { ArrowRight } from '@lucide/astro'
import { site } from '../data/site'
import { courses } from '../data/courses'
import { locations } from '../data/locations'

const contactHref = Astro.url.pathname === '/' ? '#kontakt' : '/kontakt#prihlaska'

const cols = [
  {
    title: 'Kurzy',
    links: courses.map((c) => ({ label: c.title, href: c.href })),
  },
  {
    title: 'Info',
    links: [
      { label: 'Všechny kurzy', href: '/kurzy' },
      { label: 'Ceník', href: '/cenik' },
      { label: 'Proč my', href: '/#proc' },
      { label: 'Recenze', href: '/#recenze' },
      ...locations.map((l) => ({ label: `Pobočka ${l.short}`, href: l.href })),
    ],
  },
  {
    title: 'Kontakt',
    links: [
      { label: 'Dopraváků 723, Praha 8', href: site.mapsPraha, external: true },
      { label: 'Chotusice 136, nonstop', href: site.mapsChotusice, external: true },
      { label: site.phone.display, href: site.phone.href },
      { label: site.email, href: `mailto:${site.email}` },
    ],
  },
]

const year = new Date().getFullYear()
---

<footer class="bg-[var(--ink)] text-white pt-20 pb-10">
  <div class="max-w-7xl mx-auto px-5 lg:px-10">
    <div class="grid lg:grid-cols-12 gap-10 pb-16 border-b border-white/10">
      <div class="lg:col-span-6">
        <div class="font-display font-bold text-[clamp(48px,7vw,108px)] leading-[0.9] tracking-tight">
          Začni jezdit.<br /><span class="text-[var(--lime)]">Začni dnes.</span>
        </div>
        <a href={contactHref} class="mt-8 inline-flex items-center gap-2 bg-[var(--lime)] text-[var(--ink)] font-semibold px-7 py-4 rounded-full btn-primary">
          Zapsat se <ArrowRight size={16} />
        </a>
      </div>
      <div class="lg:col-span-6 grid sm:grid-cols-[1fr_1fr_1.35fr] gap-8 text-[14px]">
        {cols.map((c) => (
          <div>
            <div class="text-[13px] text-white/50 mb-4">{c.title}</div>
            <ul class="space-y-2.5">
              {c.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="ulink hover:text-[var(--lime)] break-words"
                    {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}
                  >{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="pt-8 flex flex-wrap items-center justify-between gap-4 text-[13px] text-white/50">
      <div>© {year} Autoškola KETTY · Bc. Renáta Kettnerová</div>
      <a href="#obsah" class="hover:text-[var(--lime)]">Zpět nahoru</a>
    </div>
  </div>
</footer>
